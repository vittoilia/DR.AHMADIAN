# Ahmadian Academy — environment variables (names and meaning only).
# Real values live in the host's environment settings (Netlify: Site
# configuration → Environment variables; cPanel: Setup Node.js App →
# Environment variables) or in a private .env next to server.mjs that is
# never committed. `npm run secrets` generates a complete set.

# production | development (Netlify sets production automatically)
NODE_ENV=
# public address, e.g. https://academy.example.ir (Netlify provides URL automatically)
SITE_URL=

# --- secrets (required in production) ---
# random key for sessions, puzzles and reset links (48+ random bytes)
APP_SECRET=
# 32-byte base64 key that encrypts national IDs and 2FA secrets — back it up; losing it loses those fields
DATA_ENCRYPTION_KEY=
# the hidden admin panel path segment: 24–128 letters, digits, - or _ (npm run secrets makes two UUIDs)
ADMIN_PATH=
# first super administrator, created once while none exists
ADMIN_BOOTSTRAP_USERNAME=
# scrypt hash of that admin's password (from npm run secrets / create-admin) — never the password itself
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# --- database ---
# netlify (Netlify Database) | postgres | mysql | sqlite
DB_DRIVER=
# postgres://user:pass@host:5432/db or mysql://user:pass@localhost:3306/db (not needed for netlify/sqlite)
DATABASE_URL=
# sqlite file (local development only)
SQLITE_PATH=data/academy.sqlite
# app = the app migrates on start (default off Netlify) | platform = Netlify applies netlify/database/migrations
MIGRATIONS=

# --- file storage ---
# blobs (Netlify Blobs) | fs (a folder on the server — keep it outside public_html)
STORAGE_DRIVER=
STORAGE_DIR=data/storage

# --- server (cPanel / VPS) ---
PORT=
HOST=127.0.0.1
# 1 behind a proxy you control (cPanel/Passenger, Cloudflare, ArvanCloud) so client IPs are read correctly
TRUST_PROXY=0
# auto (seed content once) | off
SEED=auto

# --- development only ---
# fixed password for the local "admin" account (otherwise a random one is printed)
DEV_ADMIN_PASSWORD=
